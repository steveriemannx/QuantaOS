+    pub debug_name: [u8; 64],
+}
+
+impl CtxCreate {
+    pub fn new(ctx_id: u32, name: &[u8]) -> Self {
+        let mut debug_name = [0u8; 64];
+        let len = name.len().min(debug_name.len());
+        debug_name[..len].copy_from_slice(&name[..len]);
+        Self {
+            header: ControlHeader {
+                ty: CommandTy::CtxCreate,
+                ctx_id,
+                ..Default::default()
+            },
+            nlen: len as u32,
+            context_init: 0,
+            debug_name,
+        }
+    }
+}
