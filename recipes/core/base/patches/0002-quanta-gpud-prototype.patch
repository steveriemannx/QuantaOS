+use std::sync::Arc;
+
+use common::dma::Dma;
+use virtio_core::spec::{Buffer, ChainBuilder, DescriptorFlags};
+use virtio_core::transport::{Error, Queue, Transport};
+
+/// Minimal QuantaGPU driver: one virtio-gpu 3D scanout, no DRM/KMS, no Vulkan.
+struct QuantaGpu {
+    control_queue: Arc<Queue>,
+    num_capsets: u32,
+    _transport: Arc<dyn Transport>,
+}
+
+impl QuantaGpu {
+    async fn send_request<T: Send + 'static>(
+        &self,
+        request: Dma<T>,
+    ) -> Result<Dma<ControlHeader>, Error> {
+        let header = Dma::new(ControlHeader::default())?;
+        let command = ChainBuilder::new()
+            .chain(Buffer::new(request))
+            .chain(Buffer::new(header).flags(DescriptorFlags::WRITE_ONLY))
+            .build();
+
+        let (_, [_, header]) = self.control_queue.send(command).await.into_parts();
+        Ok(header.into_inner())
+    }
+
+    async fn get_display_info(&self) -> anyhow::Result<Dma<GetDisplayInfo>> {
+        let header = Dma::new(ControlHeader::with_ty(CommandTy::GetDisplayInfo))?;
+        let response = Dma::new(GetDisplayInfo::default())?;
+        let command = ChainBuilder::new()
+            .chain(Buffer::new(header))
+            .chain(Buffer::new(response).flags(DescriptorFlags::WRITE_ONLY))
+            .build();
+        let (_, [_, response]) = self.control_queue.send(command).await.into_parts();
+        let response: Dma<GetDisplayInfo> = response.into_inner();
+        anyhow::ensure!(
+            response.header.ty == CommandTy::RespOkDisplayInfo,
+            "get_display_info failed: {:?}",
+            response.header.ty
+        );
+        Ok(response)
+    }
+
+    async fn get_capset_info(&self, index: u32) -> anyhow::Result<Dma<GetCapsetInfoResp>> {
+        let request = Dma::new(GetCapsetInfo::new(index))?;
+        let response = Dma::new(GetCapsetInfoResp::default())?;
+        let command = ChainBuilder::new()
+            .chain(Buffer::new(request))
+            .chain(Buffer::new(response).flags(DescriptorFlags::WRITE_ONLY))
+            .build();
+        let (_, [_, response]) = self.control_queue.send(command).await.into_parts();
+        let response: Dma<GetCapsetInfoResp> = response.into_inner();
+        anyhow::ensure!(
+            response.header.ty == CommandTy::RespOkCapsetInfo,
+            "get_capset_info({index}) failed: {:?}",
+            response.header.ty
+        );
+        Ok(response)
+    }
+
+    async fn ctx_create(&self) -> anyhow::Result<()> {
+        let request = Dma::new(CtxCreate::new(QUANTA_CTX_ID, b"quanta-gpu"))?;
+        let header = self.send_request(request).await?;
+        anyhow::ensure!(
+            header.ty == CommandTy::RespOkNodata,
+            "ctx_create failed: {:?}",
+            header.ty
+        );
+        Ok(())
+    }
+
+    async fn resource_create_3d(
+        &self,
+        width: u32,
+        height: u32,
+    ) -> anyhow::Result<ResourceId> {
+        let resource_id = ResourceId::alloc();
+        let request = Dma::new(ResourceCreate3d::new(resource_id, width, height))?;
+        let header = self.send_request(request).await?;
+        anyhow::ensure!(
+            header.ty == CommandTy::RespOkNodata,
+            "resource_create_3d failed: {:?}",
+            header.ty
+        );
+        Ok(resource_id)
+    }
+
+    async fn ctx_attach_resource(&self, resource_id: ResourceId) -> anyhow::Result<()> {
+        let request = Dma::new(CtxResource::attach(QUANTA_CTX_ID, resource_id))?;
+        let header = self.send_request(request).await?;
+        anyhow::ensure!(
+            header.ty == CommandTy::RespOkNodata,
+            "ctx_attach_resource failed: {:?}",
+            header.ty
+        );
+        Ok(())
+    }
+
+    async fn set_scanout(
+        &self,
+        resource_id: ResourceId,
+        width: u32,
+        height: u32,
+    ) -> anyhow::Result<()> {
+        let request = Dma::new(SetScanout::new(
+            0,
+            resource_id,
+            GpuRect::new(0, 0, width, height),
+        ))?;
+        let header = self.send_request(request).await?;
+        anyhow::ensure!(
+            header.ty == CommandTy::RespOkNodata,
+            "set_scanout failed: {:?}",
+            header.ty
+        );
+        Ok(())
+    }
+
+    async fn submit_3d(&self, commands: &[u32]) -> anyhow::Result<()> {
+        let byte_len = commands.len() * 4;
+        let request = Dma::new(CmdSubmit3d::new(QUANTA_CTX_ID, byte_len as u32))?;
+        let mut bytes: Dma<[u8]> = unsafe { Dma::zeroed_slice(byte_len)?.assume_init() };
+        for (index, word) in commands.iter().enumerate() {
+            bytes[index * 4..index * 4 + 4].copy_from_slice(&word.to_le_bytes());
+        }
+        let response = Dma::new(ControlHeader::default())?;
+        let command = ChainBuilder::new()
+            .chain(Buffer::new(request))
+            .chain(Buffer::new(bytes))
+            .chain(Buffer::new(response).flags(DescriptorFlags::WRITE_ONLY))
+            .build();
+        let (_, [_, _, header]) = self.control_queue.send(command).await.into_parts();
+        let header: Dma<ControlHeader> = header.into_inner();
+        anyhow::ensure!(
+            header.ty == CommandTy::RespOkNodata,
+            "submit_3d failed: {:?}",
+            header.ty
+        );
+        Ok(())
+    }
+
+    async fn flush(
+        &self,
+        resource_id: ResourceId,
+        width: u32,
+        height: u32,
+    ) -> anyhow::Result<()> {
+        let request = Dma::new(ResourceFlush::new(
+            resource_id,
+            GpuRect::new(0, 0, width, height),
+        ))?;
+        let header = self.send_request(request).await?;
+        anyhow::ensure!(
+            header.ty == CommandTy::RespOkNodata,
+            "resource_flush failed: {:?}",
+            header.ty
+        );
+        Ok(())
+    }
+
+    async fn initialize(&mut self) -> anyhow::Result<()> {
+        let mut capset = None;
+        for index in 0..self.num_capsets.max(1) {
+            let info = self.get_capset_info(index).await?;
+            log::info!(
+                "quanta-gpud: capset {index}: id={} version={} size={}",
+                info.capset_id,
+                info.capset_max_version,
+                info.capset_max_size
+            );
+            if info.capset_id == VIRTIO_GPU_CAPSET_VIRGL
+                || info.capset_id == VIRTIO_GPU_CAPSET_VIRGL2
+            {
+                capset = Some(info.capset_id);
+                break;
+            }
+        }
+        anyhow::ensure!(capset.is_some(), "no virgl capset found");
+
+        let display_info = self.get_display_info().await?;
+        let first = &display_info.display_info[0];
+        let (width, height) = if first.rect.width > 0 && first.rect.height > 0 {
+            (first.rect.width, first.rect.height)
+        } else {
+            (1024, 768)
+        };
+        log::info!("quanta-gpud: display 0 is {width}x{height}");
+
+        self.ctx_create().await?;
+        let resource_id = self.resource_create_3d(width, height).await?;
+        self.ctx_attach_resource(resource_id).await?;
+        self.set_scanout(resource_id, width, height).await?;
+
+        let commands =
+            virgl_clear_commands(resource_id, width, height, [0.06, 0.22, 0.60, 1.0]);
+        self.submit_3d(&commands).await?;
+        self.flush(resource_id, width, height).await?;
+
+        log::info!("quanta-gpud: virgl clear submitted for resource {resource_id:?}");
+        Ok(())
+    }
+}
+
+fn virgl_cmd0(cmd: u32, obj: u32, len: u32) -> u32 {
+    cmd | (obj << 8) | (len << 16)
+}
+
+fn push_virgl_cmd(out: &mut Vec<u32>, cmd: u32, obj: u32, payload: &[u32]) {
+    out.push(virgl_cmd0(cmd, obj, payload.len() as u32));
+    out.extend_from_slice(payload);
+}
+
+fn virgl_clear_commands(
+    resource_id: ResourceId,
+    width: u32,
+    height: u32,
+    color: [f32; 4],
+) -> Vec<u32> {
+    let mut out = Vec::new();
+
+    push_virgl_cmd(
+        &mut out,
+        VIRGL_CCMD_CREATE_OBJECT,
+        VIRGL_OBJECT_SURFACE,
+        &[
+            QUANTA_SURFACE_HANDLE,
+            resource_id.0,
+            VIRGL_FORMAT_B8G8R8A8_UNORM,
+            0,
+            0,
+        ],
+    );
+    push_virgl_cmd(
+        &mut out,
+        VIRGL_CCMD_SET_FRAMEBUFFER_STATE,
+        0,
+        &[1, 0, QUANTA_SURFACE_HANDLE],
+    );
+
+    let mut viewport = vec![0u32];
+    for value in [
+        width as f32 / 2.0,
+        height as f32 / 2.0,
+        1.0,
+        width as f32 / 2.0,
+        height as f32 / 2.0,
+        0.0,
+    ] {
+        viewport.push(value.to_bits());
+    }
+    push_virgl_cmd(&mut out, VIRGL_CCMD_SET_VIEWPORT_STATE, 0, &viewport);
+
+    let mut clear = vec![PIPE_CLEAR_COLOR0];
+    for value in color {
+        clear.push(value.to_bits());
+    }
+    clear.extend_from_slice(&[0, 0, 0]);
+    push_virgl_cmd(&mut out, VIRGL_CCMD_CLEAR, 0, &clear);
+
+    out
+}
+
+fn main() {
+    pcid_interface::pci_daemon(daemon_runner);
+}
+
+fn daemon_runner(daemon: daemon::Daemon, mut pcid_handle: PciFunctionHandle) -> ! {
+    common::setup_logging(
+        "graphics",
+        "pci",
+        "quanta-gpud",
+        common::output_level(),
+        common::file_level(),
+    );
+
+    let pci_config = pcid_handle.config();
+    assert_eq!(pci_config.func.full_device_id.device_id, 0x1050);
+    log::info!("quanta-gpud: starting");
+
+    let device = match virtio_core::probe_device(&mut pcid_handle) {
+        Ok(device) => device,
+        Err(err) => {
+            log::error!("quanta-gpud: probe_device failed: {err:?}");
+            std::process::exit(1);
+        }
+    };
+    let config = unsafe { &mut *(device.device_space as *mut GpuConfig) };
+
+    let has_virgl = device.transport.check_device_feature(VIRTIO_GPU_F_VIRGL);
+    if !has_virgl {
+        log::error!("quanta-gpud: virgl is not available on this device");
+        std::process::exit(1);
+    }
+    device.transport.ack_driver_feature(VIRTIO_GPU_F_VIRGL);
+    device.transport.finalize_features();
+
+    let control_queue = match device.setup_queue() {
+        Ok(queue) => queue,
+        Err(err) => {
+            log::error!("quanta-gpud: control queue setup failed: {err:?}");
+            std::process::exit(1);
+        }
+    };
+    if let Err(err) = device.setup_queue() {
+        log::error!("quanta-gpud: cursor queue setup failed: {err:?}");
+        std::process::exit(1);
+    }
+
+    device.transport.run_device();
+
+    let mut gpu = QuantaGpu {
+        control_queue,
+        num_capsets: config.num_capsets(),
+        _transport: device.transport.clone(),
+    };
+
+    match futures::executor::block_on(gpu.initialize()) {
+        Ok(()) => {
+            daemon.ready();
+            log::info!("quanta-gpud: ready");
+        }
+        Err(err) => {
+            log::error!("quanta-gpud: initialization failed: {err:?}");
+            std::process::exit(1);
+        }
+    }
+
+    loop {
+        std::thread::sleep(std::time::Duration::from_secs(3600));
+    }
+}
