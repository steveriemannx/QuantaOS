+#[derive(Debug)]
+#[repr(C)]
+pub struct ControlHeader {
+    pub ty: CommandTy,
+    pub flags: u32,
+    pub fence_id: u64,
+    pub ctx_id: u32,
+    pub ring_index: u8,
+    padding: [u8; 3],
+}
+
+impl ControlHeader {
+    pub fn with_ty(ty: CommandTy) -> Self {
+        Self {
+            ty,
+            ..Default::default()
+        }
+    }
+}
+
+impl Default for ControlHeader {
+    fn default() -> Self {
+        Self {
+            ty: CommandTy::Undefined,
+            flags: 0,
+            fence_id: 0,
+            ctx_id: 0,
+            ring_index: 0,
+            padding: [0; 3],
+        }
+    }
+}
